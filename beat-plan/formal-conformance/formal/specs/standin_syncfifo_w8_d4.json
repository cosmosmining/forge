{
  "schema": "forge.formal.spec/v1",
  "block": "standin_syncfifo_w8_d4",
  "standin": true,
  "description": "Amaranth SyncFIFO(width=8, depth=4), generated RTL (stand-in, not a Forge block). Contract from the Amaranth FIFOInterface / SyncFIFO docstrings; ordering checked by following one arbitrarily chosen write.",
  "rtl": ["../../standins/rtl/syncfifo_w8_d4.v"],
  "instances": [
    {
      "name": "dut",
      "module": "syncfifo_w8_d4",
      "expose_prep": ["proc", "memory -nomap", "memory_map", "opt_clean"],
      "expose": ["w:produce", "w:consume", "w:storage*"]
    }
  ],
  "clock": "clk",
  "reset": {"port": "rst", "active_low": false, "init_cycles": 1},
  "free_inputs": {"f_pick": 1},
  "helper_sv": [
    "// Ordering tracker: follows one write, chosen by the free input f_pick at any time.",
    "reg       f_trk_active = 1'b0;",
    "reg       f_trk_done   = 1'b0;",
    "reg [2:0] f_trk_ahead  = 3'd0;  // entries queued ahead of the tracked one",
    "reg [7:0] f_trk_data   = 8'd0;",
    "reg       f_seen_full  = 1'b0;",
    "wire      f_do_w = w_en && w_rdy;",
    "wire      f_do_r = r_en && r_rdy;",
    "always @(posedge f_clk) begin",
    "    if (f_rst) begin",
    "        f_trk_active <= 1'b0;",
    "        f_trk_done   <= 1'b0;",
    "        f_seen_full  <= 1'b0;",
    "    end else begin",
    "        if (level == 3'd4) f_seen_full <= 1'b1;",
    "        if (!f_trk_active && !f_trk_done && f_pick && f_do_w) begin",
    "            f_trk_active <= 1'b1;",
    "            f_trk_ahead  <= level - {2'b00, f_do_r};",
    "            f_trk_data   <= w_data;",
    "        end else if (f_trk_active && f_do_r) begin",
    "            if (f_trk_ahead == 3'd0) begin",
    "                f_trk_active <= 1'b0;",
    "                f_trk_done   <= 1'b1;",
    "            end else begin",
    "                f_trk_ahead <= f_trk_ahead - 3'd1;",
    "            end",
    "        end",
    "    end",
    "end",
    "// storage word that holds the tracked entry (used only by a strengthening invariant)",
    "wire [1:0] f_trk_slot = consume + f_trk_ahead[1:0];",
    "reg  [7:0] f_trk_word;",
    "always @(*) begin",
    "    case (f_trk_slot)",
    "        2'd0: f_trk_word = storage_0;",
    "        2'd1: f_trk_word = storage_1;",
    "        2'd2: f_trk_word = storage_2;",
    "        default: f_trk_word = storage_3;",
    "    endcase",
    "end"
  ],
  "properties": [
    {"id": "p_empty_after_reset", "type": "assert_after_reset",
     "expr": "level == 3'd0 && !r_rdy && w_rdy",
     "source": "SyncFIFO.level = number of unread entries; reset value 0 (empty queue)"},
    {"id": "p_level_le_depth", "type": "assert", "expr": "level <= 3'd4",
     "source": "SyncFIFO.level: Signal(range(depth + 1)), number of unread entries"},
    {"id": "p_w_rdy_iff_space", "type": "assert", "expr": "w_rdy == (level < 3'd4)",
     "source": "FIFOInterface.w_rdy: asserted if there is space in the queue"},
    {"id": "p_r_rdy_iff_entry", "type": "assert", "expr": "r_rdy == (level != 3'd0)",
     "source": "FIFOInterface.r_rdy: asserted if there is an entry in the queue"},
    {"id": "p_levels_agree", "type": "assert", "expr": "w_level == level && r_level == level",
     "source": "SyncFIFO: level is the same between read and write for synchronous FIFOs"},
    {"id": "p_level_accounting", "type": "assert_next",
     "expr": "level == $past(level) + {2'b00, $past(w_en && w_rdy)} - {2'b00, $past(r_en && r_rdy)}",
     "source": "w_en latches w_data, does nothing if w_rdy is low; r_en pops, does nothing if r_rdy is low"},
    {"id": "p_fifo_order", "type": "assert",
     "expr": "!(f_trk_active && f_trk_ahead == 3'd0) || (r_rdy && r_data == f_trk_data)",
     "source": "FIFOInterface: the entry written first appears first on the output; r_data valid if r_rdy"},
    {"id": "s_ptr_vs_level", "type": "assert", "role": "strengthening",
     "expr": "(produce - consume) == level[1:0]",
     "source": "induction helper over generated internals produce/consume (not a contract)"},
    {"id": "s_trk_ahead_lt_level", "type": "assert", "role": "strengthening",
     "expr": "!f_trk_active || (f_trk_ahead < level)",
     "source": "induction helper: the tracked entry is still in the queue"},
    {"id": "s_trk_word", "type": "assert", "role": "strengthening",
     "expr": "!f_trk_active || (f_trk_word == f_trk_data)",
     "source": "induction helper over generated internal storage words"}
  ],
  "covers": [
    {"id": "c_full", "expr": "level == 3'd4"},
    {"id": "c_read_write_same_cycle", "expr": "w_en && w_rdy && r_en && r_rdy"},
    {"id": "c_drained_after_full", "expr": "f_seen_full && level == 3'd0"},
    {"id": "c_tracked_behind_three", "expr": "f_trk_active && f_trk_ahead == 3'd3"},
    {"id": "c_tracked_delivered", "expr": "f_trk_done"}
  ],
  "bit_exact": {
    "claim": "every entry read out equals the entry written, in write order (data path bit-exact)",
    "method": "formal: unbounded proof by k-induction, arbitrary write tracked, all 8-bit data values"
  },
  "depth": {"prove": 8, "cover": 16},
  "mutation": {"module": "syncfifo_w8_d4", "count": 40, "seed": 1, "depth": 12}
}
